    <div class="cta-row">
      <a class="btn" href="#cases">See leadership in action</a>
      <a class="text-link" href="mailto:bella@pathwayanalytics.com">bella@pathwayanalytics.com</a>
    </div>
    <div class="hero-note">Founder and Director, Pathway Analytics · 30 years across corporate, government, health and public life</div>
  </div>
  <figure class="portrait">
    <img src="/portrait.jpg" alt="Portrait of Bella Grant" />
    <figcaption>BELLA GRANT · PATHWAY ANALYTICS</figcaption>
  </figure>
