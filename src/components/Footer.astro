---
/**
 * Footer component
 * Displays company name/description and dynamic copyright year.
 */
---

<footer class="wrap">
  <span>Pathway Analytics Ltd · Strategy, public leadership &amp; advocacy</span>
  <span>© <span id="year"></span> Pathway Analytics</span>
</footer>

<script>
  document.getElementById('year')!.textContent = new Date().getFullYear().toString();
</script>
