---
import { projects } from "../data/projects";
---

<section class="work wrap" id="work">
  <div class="work-intro">
    <h2>Selected work</h2>
    <p>These examples show the type of problem, the role I played and the decision or system change the work supported.</p>
  </div>

  <div class="projects">
    {projects.map(project => (
      <article class={`project${project.isCurrent ? ' current' : ''}`}>
        <div class="tag">{project.tag}</div>
        <h3>{project.title}</h3>
        {project.paragraphs.map(p => <p>{p}</p>)}
        <div class="outcome">
          <strong>{project.outcomeLabel}</strong> {project.outcomeText}
        </div>
      </article>
    ))}
  </div>
</section>
