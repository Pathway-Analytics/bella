---
/**
 * Proof component — displays 4 key statistics as social proof.
 * Each stat has a .figure (the number) and .label (description).
 */
---

<section class="proof" aria-label="Selected evidence of scale">
  <div class="wrap proof-grid">
    <div>
      <div class="figure">30 years</div>
      <div class="label">Operating across corporate, consulting, government, health and politics</div>
    </div>
    <div>
      <div class="figure">£50m+</div>
      <div class="label">Reported savings associated with the wider sexual-health service redesign</div>
    </div>
    <div>
      <div class="figure">43 SARCs</div>
      <div class="label">National review spanning more than 100 voluntary-sector organisations</div>
    </div>
    <div>
      <div class="figure">9,533</div>
      <div class="label">Votes in a new parliamentary constituency after a six-week campaign</div>
    </div>
  </div>
</section>
