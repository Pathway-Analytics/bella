---
/**
 * Proof component — displays 4 key statistics as social proof.
 * Each stat has a .figure (the number) and .label (description).
 */
---

<section class="proof" aria-label="Selected evidence of experience">
  <div class="wrap proof-grid">
    <div>
      <div class="figure">140+</div>
      <div class="label">Clinical pathways costed for the Integrated Sexual Health Tariff</div>
    </div>
    <div>
      <div class="figure">43</div>
      <div class="label">Sexual Assault Referral Centres included in national pathway work</div>
    </div>
    <div>
      <div class="figure">100+</div>
      <div class="label">Voluntary-sector organisations considered in the sexual-assault review</div>
    </div>
    <div>
      <div class="figure">120+</div>
      <div class="label">Stakeholder interviews for London's HIV Fast-Track Cities review</div>
    </div>
  </div>
</section>
